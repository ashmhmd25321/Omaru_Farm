DB_PASSWORD=
DB_NAME=omaru_farm

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-strong-password
ADMIN_JWT_SECRET=change-me-to-a-long-random-secret-32chars-min
CUSTOMER_JWT_SECRET=change-me-to-another-long-random-secret

FEATURE_CHECKOUT=true
STRIPE_CURRENCY=aud
STRIPE_SECRET_KEY=
