PORT=4000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=omaru_farm

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-strong-password
ADMIN_JWT_SECRET=change-me-to-a-long-random-secret-32chars-min
CUSTOMER_JWT_SECRET=change-me-to-another-long-random-secret

FEATURE_CHECKOUT=true
STRIPE_CURRENCY=aud
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

PUBLIC_SITE_URL=http://127.0.0.1:5173
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
COOKIE_SECURE=false

# Café table-hold abuse protection (defaults: 8 requests / 15 minutes per IP)
TABLE_HOLD_MAX_ATTEMPTS=8
TABLE_HOLD_WINDOW_MS=900000

# Farm calendar timezone used for “past date” checks
FARM_TIMEZONE=Australia/Melbourne

# Australia Post Postage Assessment Calculator (checkout rates)
AUSPOST_ENABLED=true
AUSPOST_PAC_API_KEY=
AUSPOST_ORIGIN_POSTCODE=3922
AUSPOST_PREFERRED_SERVICE=AUS_PARCEL_REGULAR
# Fail closed by default: do not charge placeholder rates if AusPost is unavailable.
AUSPOST_FALLBACK_TO_MATRIX=false
AUSPOST_DEFAULT_LENGTH_CM=20
AUSPOST_DEFAULT_WIDTH_CM=15
AUSPOST_DEFAULT_HEIGHT_CM=10
# Set true only while testing with estimated product pack data.
SHIPPING_DATA_PROVISIONAL=false
