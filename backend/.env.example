# Café table-hold abuse protection (defaults: 8 requests / 15 minutes per IP)
TABLE_HOLD_MAX_ATTEMPTS=8
TABLE_HOLD_WINDOW_MS=900000

# Farm calendar timezone used for “past date” checks
FARM_TIMEZONE=Australia/Melbourne
